{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "artifacts" }],
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": { "GITHUB_CLIENT_ID": "", "ALLOWED_USERS": "" },
  "triggers": { "crons": ["0 3 * * *"] },
  "assets": { "directory": "./public" },
  "observability": { "enabled": true }
}
